# MilaServ Portal — environment template
#
# Copy to `.env` and fill in real values. `.env` is git-ignored and must
# NEVER be committed. Values below are placeholders only.

# --- Supabase (server-side) -------------------------------------------------
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
# Anon/publishable key. Safe to expose to the browser; RLS is the boundary.
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# --- Supabase (client-side, inlined by Vite at build time) ------------------
# Only ever put browser-safe values behind a VITE_ prefix — anything here is
# baked into the public bundle.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# --- Supabase service role (server-only, NEVER prefixed with VITE_) ---------
# Bypasses RLS. Set only in the deployment environment (e.g. Cloudflare Worker
# secrets). Never commit a real value and never expose it to client code.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Google Maps Platform ---------------------------------------------------
# TWO keys, on purpose. They have opposite security models and must not be the
# same value — see src/lib/maps/config.ts.
#
# Browser key: the Maps JavaScript API loads via a <script> tag, so this key is
# necessarily visible in the page. That is how the product works, not a leak.
# Protect it in the Google Cloud console with an HTTP-referrer restriction
# limited to the portal's domains, and an API restriction limited to
# "Maps JavaScript API". Leave blank and the app falls back to its built-in SVG
# map — every other feature keeps working.
VITE_GOOGLE_MAPS_BROWSER_KEY=""

# Server key: Geocoding, Routes/Distance Matrix and Places are called from our
# own server and this key never reaches a browser. Restrict it by IP, and to
# those APIs only. This is the key that can run up a bill. Leave blank and the
# Distance Engine falls back to straight-line distances.
GOOGLE_MAPS_API_KEY=""

# --- Yeastar PBX (server-only) ---------------------------------------------
YEASTAR_BASE_URL=""
YEASTAR_CLIENT_ID=""
YEASTAR_CLIENT_SECRET=""
YEASTAR_UTC_OFFSET_MINUTES="180"
# UNUSED, and deliberately so. Kept only to document that it must not be
# reintroduced: the Call Report API's wire format is `DD/MM/YYYY hh:mm:ss AM|PM`
# and is a constant of the API, not a deployment choice — the PBX's own v2.0
# validator states it ("valid format: 02/01/2006 03:04:05 PM"). The value below
# is wrong on both field order and clock; `call-report.server.ts` hard-codes the
# correct format and never reads this. A malformed value does not fail loudly —
# openapi/v1.0 accepts it, ignores the window and returns zero rows.
YEASTAR_DATETIME_FORMAT="yyyy/MM/dd HH:mm:ss"
# Call-centre operating window, in the business timezone. Calls arriving outside
# it are reported but excluded from operational KPIs.
#   Format: "<days> <HH:MM>-<HH:MM>", days as sun/mon/.../sat, ranges and lists
#   both allowed:  "sun-thu 08:00-17:00"   "sat,sun 09:00-22:00"
# LEAVE EMPTY to apply no after-hours rule at all. The PBX cannot supply this
# (queue 6400 has enable_time_condition: 0), and guessing a window silently
# moves every KPI — check the calls-per-hour histogram on
# /admin/yeastar-diagnostics before setting it.
YEASTAR_BUSINESS_HOURS=""
# Outbound ring timeout in seconds, as configured on the PBX. Separates a
# genuine No Answer (customer let it ring out) from an Agent Cancelled call
# (agent hung up early) — both carry disposition "NO ANSWER", so this is the
# only discriminator. Defaults to 60. Read the true value off the unanswered-
# outbound ring histogram on /admin/yeastar-diagnostics: it is the spike at the
# top of the distribution.
YEASTAR_OUTBOUND_RING_TIMEOUT_SEC="60"

# --- CDR synchronization (server-only) --------------------------------------
# The background layer that mirrors PBX call records into Supabase so the Calls
# dashboards read from Postgres instead of waiting on a live sweep. Yeastar
# stays the source of truth; the mirror only ever holds rows the PBX emitted.
#
# Shared secret a SCHEDULER presents to POST /api/cdr-sync (Cloudflare cron,
# Vercel cron, or any external timer). A cron job has no Supabase session, so it
# cannot use the portal's normal bearer token. Leave EMPTY and the secret path is
# closed entirely — the endpoint then only accepts an administrator's token, and
# synchronization happens opportunistically as dashboards sweep windows.
CDR_SYNC_SECRET=""
# How far back the mirror is kept complete, in business days. Covers the widest
# dashboard preset (a month) and Call Lookup's 90-day ceiling. Default 90.
YEASTAR_CDR_SYNC_HORIZON_DAYS="90"
# Days one run may sweep. A run executes inside a request, so it is bounded and
# a backfill WALKS: each run takes the live days plus the oldest days still
# missing, and successive runs converge on a covered horizon. Default 7.
YEASTAR_CDR_SYNC_MAX_DAYS_PER_RUN="7"

# --- Shams Pharmacy MIS (server-only) ---------------------------------------
# Origin of the MIS API, no trailing slash and no path — the client appends
# `/api/v2/...` itself. Leave EMPTY and the Shams module reports "not configured"
# and every server function returns an empty result; nothing else breaks.
SHAMS_MIS_BASE_URL=""

# Credentials for `POST /api/v2/auth/login`.
#
# READ THIS BEFORE SETTING THEM. The MIS *data* endpoints — product search,
# product info, product stock, sales/details, crm/data, dashboards — perform NO
# authentication: they accept requests with no Authorization header, no cookie
# and no session parameter, and answer with `Access-Control-Allow-Origin: *`.
# The login endpoint returns a user profile and the portal's nav permissions; it
# issues no token and sets no cookie. Verified across a full HAR capture — see
# docs/shams/api-discovery.md.
#
# So these are NOT required for the integration to function, and no read path
# calls login(). They exist so an administrator can confirm the account still
# works via the `shamsStatus` server function. Leave them empty and every
# product/stock/invoice read still works; only the credential check reports
# "not configured".
#
# Server-only, deliberately un-prefixed: a VITE_ copy would be inlined into the
# public bundle. Never commit real values.
SHAMS_MIS_USERNAME=""
SHAMS_MIS_PASSWORD=""
